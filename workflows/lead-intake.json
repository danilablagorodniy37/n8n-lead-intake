{
  "id": "LeadIntakeMain01",
  "name": "Lead intake: form to CRM to owner approval",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LeadIntakeError1",
    "saveManualExecutions": true,
    "timezone": "Europe/London"
  },
  "nodes": [
    {
      "id": "0b1e7d1c-1111-4a3b-9c01-000000000001",
      "name": "Website form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "lead-intake-form",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "0b1e7d1c-1111-4a3b-9c01-000000000002",
      "name": "Engine: intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "http://engine:8000/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LEAD_ENGINE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "0b1e7d1c-1111-4a3b-9c01-000000000003",
      "name": "Respond to form",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [560, 160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, lead_id: $json.id, status: $json.status }) }}",
        "options": {}
      }
    },
    {
      "id": "0b1e7d1c-1111-4a3b-9c01-000000000004",
      "name": "Ask the owner (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [560, 440],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "telegramApi": {
          "id": "LeadIntakeTelegr",
          "name": "Telegram bot (lead intake)"
        }
      },
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.approval_message }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approve and send",
                    "additionalFields": {
                      "callback_data": "=approve:{{ $json.id }}"
                    }
                  },
                  {
                    "text": "Edit",
                    "additionalFields": {
                      "callback_data": "=edit:{{ $json.id }}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "=reject:{{ $json.id }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "0b1e7d1c-1111-4a3b-9c01-000000000005",
      "name": "How this works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -40],
      "parameters": {
        "width": 820,
        "height": 160,
        "content": "## Lead intake\nThe website form POSTs to the webhook. The engine (Python, http://engine:8000) normalises the fields, finds the same person by email or phone, upserts the contact and one open deal in the CRM, scores the lead against criteria.yaml and drafts a reply. The owner gets one Telegram message with three buttons. Nothing is emailed from this workflow: sending lives in \"Lead approval\" and only runs after a tap."
      }
    }
  ],
  "connections": {
    "Website form": {
      "main": [
        [
          {
            "node": "Engine: intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Engine: intake": {
      "main": [
        [
          {
            "node": "Respond to form",
            "type": "main",
            "index": 0
          },
          {
            "node": "Ask the owner (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "n8n-lead-intake"
  },
  "tags": []
}
