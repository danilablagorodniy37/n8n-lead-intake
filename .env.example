# Copy to .env. Only the Telegram pair is needed for the demo; everything else has a working default.

# --- Telegram: the owner's approval channel ---------------------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (it is "chat": {"id": ...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- engine -------------------------------------------------------------------------------------
# CRM: fake (contacts and deals in the engine's own database, counted by `leadintake report`) | hubspot
CRM_PROVIDER=fake
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEALSTAGE=appointmentscheduled

# Drafting: anthropic | openai | fake | auto (anthropic if its key is set, then openai, then fake template)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=                 # optional, needs `pip install "leadintake[openai]"`
DRAFT_MODEL=claude-haiku-5-5
# USD per million tokens [input, output]; configured values, check the provider's pricing page
# MODEL_PRICES={"claude-haiku-5-5": [0.10, 0.50], "claude-sonnet-5-5": [3.0, 15.0]}

# Protect the engine: if set, n8n sends it as "Authorization: Bearer ..." (the compose file wires it)
API_TOKEN=
DEFAULT_REGION=GB
DUPLICATE_WINDOW_HOURS=24
# Seconds the engine trusts its own write over a CRM search that has not caught up (HubSpot lags)
CRM_SEARCH_LAG_SECONDS=120
CRITERIA_PATH=criteria.yaml
# Local runs outside Docker: DATABASE_URL=sqlite:///data/leadintake.sqlite (default)

# --- email out ----------------------------------------------------------------------------------
# Defaults point at the Mailpit container, so approved replies show up at http://localhost:8025.
# For real sending use your provider's SMTP (Postmark, Brevo, Google Workspace app password).
REPLY_FROM=hello@hollisandgrey.example
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- n8n ----------------------------------------------------------------------------------------
# Generate once and never change: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_VERSION=2.43.8
# Telegram can only call a public HTTPS URL. On a laptop start the bundled tunnel
# (`docker compose --profile tunnel up -d tunnel`, read the URL from its log) and put it here;
# on a VPS, your domain. Set N8N_HOST and N8N_PROTOCOL to match.
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http
# Set to true once WEBHOOK_URL is public, so the import job switches the workflows on
N8N_ACTIVATE_WORKFLOWS=false
